# Backblaze B2 credentials.
#
# These are useful after a Computer Backup restore is saved to B2, or if we use
# B2 as a staging area for downloads. They do not, by themselves, initiate a
# Backblaze Computer Backup restore.
#
# Get these from the Backblaze web console:
#   B2 Cloud Storage / Application Keys / Add a New Application Key
#
# Use a least-privilege key if possible: readFiles + listFiles on the restore
# snapshot bucket is enough for downloading completed restore snapshots.
BACKBLAZE_B2_KEY_ID=
BACKBLAZE_B2_APPLICATION_KEY=
BACKBLAZE_B2_BUCKET=

# Optional Backblaze web account fields for browser/session automation probes.
# Prefer an interactive browser login over storing a password here.
BACKBLAZE_EMAIL=

