#!/usr/bin/env python3
"""A small Twilio Lookup v2 client; credentials stay in user configuration."""

import argparse
import base64
import json
import os
from pathlib import Path
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request


PACKAGES = ("caller_name", "line_type_intelligence", "line_status")
DEFAULT_FIELDS = list(PACKAGES)


class LookupError(Exception):
    pass


def config_path():
    base = os.environ.get("XDG_CONFIG_HOME", "")
    directory = Path(base) if base and Path(base).is_absolute() else Path.home() / ".config"
    return directory / "twilio-lookup" / "config.json"


def load_config(free=False):
    path = config_path()
    try:
        with path.open(encoding="utf-8") as stream:
            if stat.S_IMODE(os.fstat(stream.fileno()).st_mode) & 0o077:
                raise LookupError(f"Config must be private: chmod 600 {path}")
            config = json.load(stream)
    except FileNotFoundError:
        raise LookupError(f"Missing config: {path}; see lookup/README.md for local setup.")
    except (OSError, ValueError):
        raise LookupError(f"Cannot read config: {path}; expected a private JSON file.")
    if not isinstance(config, dict):
        raise LookupError("Config must be a JSON object.")
    sid, secret = config.get("api_key_sid"), config.get("api_key_secret")
    if (not isinstance(sid, str) or not sid.startswith("SK") or len(sid) != 34
            or any(c not in "0123456789abcdefABCDEF" for c in sid[2:])
            or not isinstance(secret, str) or not secret.strip()
            or secret.startswith("REPLACE_")):
        raise LookupError("Config requires an API Key SID (SK + 32 hex digits) and API key secret.")
    # --free ignores package configuration entirely, including future packages.
    fields = [] if free else config.get("fields", DEFAULT_FIELDS)
    if (not isinstance(fields, list) or any(field not in PACKAGES for field in fields)
            or len(fields) != len(set(fields))):
        raise LookupError("Config fields must be a unique list of caller_name, line_type_intelligence, line_status.")
    return sid, secret, fields


class NoRedirect(urllib.request.HTTPRedirectHandler):
    # Never forward credentials to a redirected destination.
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def fetch(number, sid, secret, fields):
    url = "https://lookups.twilio.com/v2/PhoneNumbers/" + urllib.parse.quote(number, safe="")
    if fields:
        url += "?" + urllib.parse.urlencode({"Fields": ",".join(fields)})
    token = base64.b64encode(f"{sid}:{secret}".encode()).decode("ascii")
    request = urllib.request.Request(url, headers={"Authorization": f"Basic {token}", "Accept": "application/json"})
    try:
        with urllib.request.build_opener(NoRedirect()).open(request, timeout=30) as response:
            return response.status, response.read()
    except urllib.error.HTTPError as error:
        return error.code, error.read()
    except (urllib.error.URLError, OSError, ValueError):
        raise LookupError("Unable to reach Twilio Lookup over HTTPS.")


def main(argv=None):
    parser = argparse.ArgumentParser(description="Twilio Lookup with paid caller name, line type intelligence, and line status by default.")
    parser.add_argument("number", help="Phone number; prefer E.164, e.g. +14155550100. National numbers default to US.")
    parser.add_argument("--raw", "--json", action="store_true", help="Write the exact HTTP response body, including on API errors.")
    for package in PACKAGES:
        parser.add_argument("--no-" + package.replace("_", "-"), action="store_true",
                            help="Disable " + package.replace("_", " ") + " after config selection.")
    parser.add_argument("--free", action="store_true", help="Request only free basic lookup; overrides all configured/default packages.")
    args = parser.parse_args(argv)
    if not args.number.strip():
        parser.error("number must not be empty")
    try:
        if not args.raw:
            try:
                import yaml
            except ImportError:
                raise LookupError("YAML output needs PyYAML; install lookup/requirements.txt, or use --raw.")
        sid, secret, fields = load_config(free=args.free)
        fields = [field for field in fields if not getattr(args, "no_" + field)]
        status, body = fetch(args.number, sid, secret, fields)
        if args.raw:
            sys.stdout.buffer.write(body)
        else:
            try:
                data = json.loads(body)
            except (ValueError, UnicodeError):
                raise LookupError(f"Twilio returned malformed JSON (HTTP {status}).")
            sys.stdout.write(yaml.safe_dump(data, sort_keys=False, allow_unicode=True))
        if not 200 <= status < 300:
            raise LookupError(f"Twilio Lookup failed (HTTP {status}); response body is on stdout.")
        return 0
    except LookupError as error:
        print(f"lookup: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
